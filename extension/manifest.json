{
  "manifest_version": 3,
  "name": "EPStudy Sync",
  "description": "Syncs EPStudy with Canvas, TeamSnap schedules, Membean, and both V6 and V7 workspaces.",
  "version": "1.7.1",
  "icons": {
    "128": "icon128.png"
  },
  "permissions": ["alarms", "declarativeNetRequest", "notifications", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://eastsideprep.instructure.com/*",
    "https://go.teamsnap.com/*",
    "https://*.membean.com/*",
    "https://membean.com/*",
    "https://www.eastsideprep.org/*",
    "https://sillywaffle-4.github.io/Epstudy/*",
    "https://sillywaffle-4.github.io/EPStudy-V6/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://0.0.0.0/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sillywaffle-4.github.io/Epstudy/*",
        "https://sillywaffle-4.github.io/EPStudy-V6/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://0.0.0.0/*",
        "file:///*"
      ],
      "js": ["website-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://eastsideprep.instructure.com/*",
        "https://go.teamsnap.com/*",
        "https://*.membean.com/*",
        "https://membean.com/*"
      ],
      "js": ["source-scraper.js"],
      "run_at": "document_idle"
    }
  ]
}
